---
/**
 * Volební leták do schránek — A5, několik stran.
 *
 * Není to obrázek, ale stránka: vytiskne se z prohlížeče (Ctrl+P → formát A5)
 * nebo uloží do PDF pro tiskárnu.
 *
 * PROČ TAKHLE, a ne v grafickém programu: leták si bere obsah z týchž zdrojů
 * jako web — `strana.ts`, kolekce `program`, `kandidati` a `zamery`. Nemůže
 * se s webem rozejít. Když se změní datum voleb, přibude kandidát nebo se
 * přepíše odrážka programu, změní se i leták. V grafickém programu by to byla
 * druhá kopie, která tiše zestárne — a zestárla by nepozorovaně, protože leták
 * nikdo denně neotvírá.
 *
 * STRÁNKUJE PROHLÍŽEČ, NE MY. Titulní strana má pevnou výšku, protože je
 * navržená. Všechno ostatní teče a láme se samo — program má přes dvacet
 * odrážek a jejich délka se bude měnit. Kdyby se strany dělily ručně na pevnou
 * výšku, první delší odrážka by text nechala vytéct za okraj papíru a na
 * obrazovce by si toho nikdo nevšiml.
 *
 * Stránka záměrně nepoužívá `Zaklad.astro`: leták nemá mít hlavičku, patičku
 * ani pruh „Náhled". Tokeny si bere sám, takže drží písmo i barvy webu,
 * a typografickou úpravu si vyžádá přes `<Typografie>` — jinak by mu jako
 * jedinému na celém webu chyběla, a to zrovna na papíře, kde už se to
 * neopraví.
 *
 * Do vyhledávačů nepatří — `noindex` níž a vyřazení ze sitemapy
 * v `astro.config.mjs`.
 */

import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import spolecnaFotka from '../assets/spolecna-fotka.jpg';
import Portret from '../components/Portret.astro';
import Typografie from '../components/Typografie.astro';
import { fotkaKandidata } from '../lib/portrety';
import { fotkaZameru } from '../lib/fotky-zameru';
import { BARVA_TEMATU } from '../lib/temata';
import type { Tema } from '../lib/temata';
import {
  NAZEV,
  NAZEV_UPLNY,
  NAZEV_DOPLNEK,
  CISLO_STRANY,
  HESLO_ZACATEK,
  HESLO_KONEC,
  DATUM_VOLEB,
  HODINY_VOLEB,
  VOLEBNI_MISTNOST,
  EMAIL,
  ZASTUPITELSTVO,
} from '../lib/strana';
import { odkaz } from '../lib/odkaz';
import montserratLatin from '../pisma/montserrat-latin.woff2?url';
import montserratLatinExt from '../pisma/montserrat-latin-ext.woff2?url';
import '../styles/tokeny.css';

/*
 * Odrážky se na leták nepřepisují — vykreslí se tentýž Markdown, jaký je
 * na `/program/`. Kdyby se opsaly, rozešly by se při první úpravě programu.
 */
const oblasti = await Promise.all(
  (await getCollection('program'))
    .sort((a, b) => a.data.poradi - b.data.poradi)
    .map(async (o) => ({ ...o, Obsah: (await render(o)).Content })),
);

/*
 * Ke kandidatum se nacita i telo jejich medailonku, aby se dalo pouzit jako
 * slovo kandidata na letaku. Neni to druhy text: je to tentyz Markdown, ktery
 * je na `/lide/`. Kdyby se na letak opsal zvlast, rozesel by se pri prvni
 * uprave - a nikdo by si toho nevsiml, protoze letak se neotvira denne.
 *
 * Vygenerovana sablona kandidata obsahuje jen HTML komentar s pokyny, takze
 * telo vypada vyplnene, i kdyz v nem nic neni. Komentare se proto pred
 * merenim delky odstrani.
 */
const kandidati = await Promise.all(
  (await getCollection('kandidati'))
    .sort((a, b) => a.data.poradi - b.data.poradi)
    .map(async (k) => ({
      ...k,
      Medailonek: (await render(k)).Content,
      maMedailonek: (k.body ?? '').replace(/<!--[sS]*?-->/g, '').trim().length > 0,
    })),
);

/**
 * Kolik lidí odshora dostane na letáku vlastní slovo — a tím i celou šířku
 * strany. Zbytek stojí po dvou vedle sebe, aby leták nebyl o dvě strany delší
 * jen kvůli prázdnému místu vedle jmen.
 *
 * Je to jedno číslo pro obojí schválně: kdyby se počet lidí se slovem a počet
 * lidí přes celou šířku nastavoval zvlášť, dřív nebo později by se to
 * rozešlo — a poznalo by se to až na vytištěném letáku, kde by někomu slovo
 * přeteklo z úzkého sloupce.
 */
const SE_SLOVEM = 3;

/*
 * Dvě fotky ze záměrů v mapě.
 *
 * Vybrané ručně podle id, ne „první dvě, které mají fotku": na letáku jde
 * o dvojici, která má vedle sebe fungovat, a to se z pořadí souborů odvodit
 * nedá. Když se záměr přejmenuje nebo fotka zmizí, leták to nezhroutí —
 * dvojice se prostě zkrátí.
 *
 * Popisky jsou tytéž jako na webu a začínají slovem „Ilustrační". Je to
 * podstatné: na papíře vedle volebního slibu se fotka čte jako „takhle to
 * tady vypadá" nebo „tohle jsme postavili", a ani na jednom z těch snímků
 * nejsou Kníničky.
 */
const UKAZKY = ['07-sportovni-hriste', '01-pristup-k-rece'];

/**
 * Za kterou oblastí programu dvojice fotek stojí.
 *
 * Obě ukazují, co slibuje Sport a rekreace — pumptrack a přístup k vodě —
 * takže patří k ní, ne na konec programu, kde by se četly jako ilustrace
 * k Bydlení.
 */
const UKAZKY_ZA = '3-sport-a-rekreace';

/**
 * Oblasti, které mají začít na nové straně.
 *
 * Je to sazečské rozhodnutí, ne vlastnost programu — proto to stojí tady
 * a ne v datech oblasti. Závisí na tom, jak dlouhé jsou zrovna texty nad ní:
 * když se program přepíše, může být zlom najednou zbytečný nebo naopak
 * chybět jinde. Po každé větší úpravě programu se to musí znovu prohlédnout
 * na hotovém PDF (`npm run letak`).
 *
 * Chvíli tu bylo `5-bydleni`. Po přesunu fotek pod Sport a rekreaci se strany
 * rozpadly jinak a zlom začal dělat díru místo pořádku — seznam je proto
 * prázdný. Zůstává tu, protože se to stane znovu.
 */
const NOVA_STRANA: string[] = [];

const zamery = await getCollection('zamery');
const ukazky = UKAZKY.map((id) => {
  const zamer = zamery.find((z) => z.id === id);
  const foto = fotkaZameru(id);
  return zamer && foto ? { zamer, foto } : null;
}).filter((u) => u !== null);

/**
 * Adresa webu na letáku a v QR kódu.
 *
 * Dokud je doména zástupná, musí to být na letáku vidět — vytištěný leták
 * s adresou, která nikam nevede, je horší než leták bez adresy. Samotný QR
 * kód vyrábí `npm run qr` do `public/qr-web.svg`; za běhu se nikam nesahá.
 */
const jeDraft = Astro.site?.hostname !== 'zakninicky.cz';
const adresaWebu = jeDraft ? 'zakninicky.cz' : Astro.site!.hostname;
---

<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Leták k tisku — {NAZEV}</title>
    <link rel="preload" href={montserratLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={montserratLatinExt} as="font" type="font/woff2" crossorigin />
  </head>

  <body>
    <Typografie>
      {/* Návod se sám netiskne — `@media print` ho schová. */}
      <p class="navod">
        <strong>Leták k tisku.</strong> Ctrl+P → formát <strong>A5</strong>, měřítko 100 %,
        zapnuté <strong>„Tisknout pozadí"</strong>. Kde přesně padnou zlomy stran, ukáže
        náhled tisku — na obrazovce text teče v jednom sloupci pod sebou.
      </p>

      {/* ---------- Titulní strana ---------- */}
      <div class="stranka">
        {/* Logo vlevo, volebni cislo vpravo nahore - stejne jako na inzerci.
            Cislo je jedina vec, kterou si ctenar musi odnest do volebni
            mistnosti, takze stoji tam, kde oko zacina. */}
        <header class="letak-hlava">
          <div>
            <img class="letak-logo" src={odkaz('/logo.svg')} alt={NAZEV} width="1073" height="155" />
            <p class="letak-doplnek">{NAZEV_DOPLNEK}</p>
          </div>

          <p class="letak-cislo">
            <span class="letak-cislo-znak">{CISLO_STRANY}</span>
            <span class="letak-cislo-popis">naše číslo<br />na lístku</span>
          </p>
        </header>

        <h1 class="letak-claim">
          <span class="letak-claim-zacatek">{HESLO_ZACATEK}</span>
          <span class="letak-claim-konec">{HESLO_KONEC}</span>
        </h1>

        {/* `eager` u všech obrázků na letáku, i u těch dole na poslední straně.
            Astro dává `<Image>` ve výchozím stavu `loading="lazy"` a to je pro
            web správně — jenže tisk nikdo neroluje. Prohlížeč pošle do tiskárny
            to, co má načtené, takže z líných obrázků vyjdou prázdná místa
            a na obrazovce se to nepozná. */}
        {/* Rozliseni pro tisk: 124 mm na 300 dpi je 1465 px, pri puvodnich
            900 px z toho bylo 184 dpi. Jedina hodnota ve `widths` schvalne -
            z vic kandidatu si prohlizec pri tisku vybere ten maly. */}
        <Image
          class="letak-foto"
          src={spolecnaFotka}
          alt={`Kandidáti sdružení ${NAZEV}`}
          widths={[1600]}
          sizes="124mm"
          quality={90}
          loading="eager"
        />

        <p class="letak-uvod">
          Jsme sdružení nezávislých kandidátů, kterým leží na srdci, aby se Kníničky staly
          místem přívětivým pro všechny — bez ohledu na věk, zájmy nebo to, jak dlouho tu žijí.
        </p>

        <div class="letak-pata-predni">
          <p class="letak-volby">
            <strong>{DATUM_VOLEB}</strong>
            pátek {HODINY_VOLEB.patek} · sobota {HODINY_VOLEB.sobota}<br />
            {VOLEBNI_MISTNOST.adresa} ({VOLEBNI_MISTNOST.vchod})
          </p>

          {/* QR vede na web. Obrázek leží v repozitáři (`npm run qr`), nestahuje
              se — leták ani web nesmí posílat požadavky na cizí servery. */}
          <p class="letak-qr">
            <img
              src={odkaz('/qr-web.svg')}
              alt={`QR kód s adresou ${adresaWebu}`}
              width="200"
              height="200"
            />
            <span>{adresaWebu}</span>
          </p>
        </div>
      </div>

      {/* ---------- Program ---------- */}
      <section class="tok tok-program">
        <h2 class="letak-nadpis">Naše priority pro Kníničky</h2>
        <p class="letak-podnadpis">
          Pět oblastí, ve kterých máme jasnou představu, kam by se Kníničky měly posunout.
        </p>

        {
          oblasti.map((oblast) => (
            <article
              class:list={['oblast', NOVA_STRANA.includes(oblast.id) && 'oblast-nova-strana']}
              style={`--barva: ${BARVA_TEMATU[oblast.data.tema as Tema]}`}
            >
              <h3 class="oblast-nadpis">
                <span class="oblast-cislo">{String(oblast.data.poradi).padStart(2, '0')}</span>
                {oblast.data.nadpis ?? oblast.data.nazev}
              </h3>
              <div class="oblast-body">
                <oblast.Obsah />
              </div>

              {oblast.id === UKAZKY_ZA && ukazky.length > 0 && (
                <div class="ukazky">
                  {ukazky.map(({ zamer, foto }) => (
                    <figure class="ukazka">
                      {/* 56 mm na 300 dpi je 661 px; 560 px davalo 254 dpi. */}
                      <Image
                        src={foto}
                        alt={zamer.data.foto_popis!}
                        widths={[700]}
                        sizes="56mm"
                        quality={90}
                        loading="eager"
                      />
                      {/* Na papire nema odkaz smysl, tiskne se jen domena -
                          aby slo dohledat, odkud snimek je. */}
                      <figcaption>
                        {zamer.data.foto_popis}
                        {zamer.data.foto_zdroj &&
                          ` Zdroj: ${new URL(zamer.data.foto_zdroj).hostname.replace(/^www\./, '')}`}
                      </figcaption>
                    </figure>
                  ))}
                </div>
              )}
            </article>
          ))
        }
      </section>

      {/* ---------- Kandidáti ---------- */}
      <section class="tok tok-lide">
        <h2 class="letak-nadpis">Kdo kandiduje</h2>

        {/* Mřížka o dvou sloupcích. První tři lidé přes oba (`.clovek` bez
            `.clovek-uzky`), protože mají slovo kandidáta a v půlce strany by
            se z něj stal úzký proužek; zbytek po dvou vedle sebe, což ušetří
            skoro celou stranu. */}
        <div class="lide-mrizka">
        {
          kandidati.map((k, poradi) => (
            <article class:list={['clovek', poradi >= SE_SLOVEM && 'clovek-uzky']}>
              {/* Portrét je v obalu, ne oblečený vlastní třídou. Astro styly
                  scopuje: `.clovek-portret` napsaná tady by dostala scope
                  téhle stránky, kdežto ten `div` vykresluje komponenta
                  `Portret` a nese scope její. Pravidlo by se nechytlo —
                  a nepoznalo by se to jinak než na rozměru fotky. */}
              <div class="clovek-portret">
                {/* `detail`, ne `karta`: jen ta velikost se v `Portret.astro`
                    načítá `eager` a jen ta sáhne po větším zdroji. Na kartě
                    webu jsou portréty líné schválně, na papíře by z nich
                    zbyla prázdná políčka. */}
                <Portret foto={fotkaKandidata(k.id)} jmeno={k.data.jmeno} velikost="detail" />
              </div>
              <div class="clovek-text">
                <p class="clovek-jmeno">
                  <span class="clovek-cislo">{k.data.poradi}</span>
                  {/* S tituly, stejne jako na inzerci - letak je blizsi hlasovacimu
                      listku nez karty na webu, kde se tituly odrezavaji. */}
                  {/* Jmeno i rodne prijmeni musi byt v JEDNOM obalu. `.clovek-jmeno`
                      je flex s mezerou mezi polozkami, takze holy text a vedle nej
                      `<span>` byly dve polozky - a mezi „Ph.D." a „, roz." se
                      objevila mezera. */}
                  <span>
                    {k.data.jmeno}
                    {k.data.rozena && <span class="clovek-rozena">roz. {k.data.rozena}</span>}
                  </span>
                </p>
                <p class="clovek-povolani">
                  {k.data.vek ? `${k.data.vek} let · ` : ''}
                  {k.data.povolani}
                  {k.data.prislusnost ? ` · ${k.data.prislusnost}` : ''}
                </p>

                {/* Slovo kandidáta má jen několik prvních lidí — u devíti by
                    z letáku byla brožura. Text se bere z pole `citace`, a když
                    je prázdné, použije se jejich medailonek z `/lide/`. Původní
                    v `src/content/kandidati/`. Dokud tam není, je vidět, že
                    chybí: vymyslet za člověka, co si myslí, nejde. */}
                {poradi < SE_SLOVEM &&
                  (k.data.citace ? (
                    <p class="clovek-slovo">{k.data.citace}</p>
                  ) : k.maMedailonek ? (
                    <div class="clovek-slovo">
                      <k.Medailonek />
                    </div>
                  ) : (
                    <p class="clovek-slovo clovek-slovo-chybi">
                      <strong>Placeholder.</strong> Sem přijde slovo kandidáta. Doplňte ho do
                      pole <code>citace</code> v souboru <code>{k.id}.md</code>, nebo mu
                      napište medailonek — tenhle rámeček pak zmizí sám.
                    </p>
                  ))}
              </div>
            </article>
          ))
        }
        </div>
      </section>

      {/* ---------- Patička letáku ---------- */}
      <section class="tok tok-pata">
        <p class="letak-vyzva">
          Nenechávejte to jen na nás. Pokud víte, že můžete něčím přispět — ať už profesí,
          dobrovolnictvím, nebo jen dobrým nápadem — ozvěte se nám.
        </p>

        <p class="letak-pata-adresa">
          <strong>{adresaWebu}</strong> · {EMAIL}
        </p>
        <p class="letak-uplny-nazev">{NAZEV_UPLNY} · volby do {ZASTUPITELSTVO}</p>
      </section>
    </Typografie>
  </body>
</html>

<style>
  /* Milimetry, ne rem: leták je fyzický papír, ne obrazovka. Kdyby se sázel
     v rem, změna základní velikosti písma v prohlížeči by rozhodila sazbu
     do tiskárny. */

  /* Okraj papíru řeší `@page`, ne odsazení prvků. Díky tomu ho mají stejný
     všechny strany — i ty, které vzniknou samy zalomením dlouhého programu
     a o kterých při psaní nevíme. */
  @page {
    size: A5;
    margin: 12mm;
  }

  body {
    margin: 0;
    padding: 0 0 10mm;
    background: #dfe3df;
    font-family: 'Montserrat', system-ui, sans-serif;
    color: var(--inkoust);
    /* Bez tohohle prohlížeč barevné plochy do tiskárny neposílá a z letáku
       zbude bílý papír s textem. */
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  .navod {
    width: 124mm;
    margin: 8mm auto;
    padding: 4mm 5mm;
    border-left: 3px solid var(--navrh);
    background: rgb(160 90 0 / 0.08);
    font-size: 3.4mm;
    line-height: 1.5;
  }

  /* Šířka 124 mm = A5 bez okrajů ze `@page`. Sloupec na obrazovce tím
     odpovídá tomu, co vyjde z tiskárny, i když se na ní strany dělí jinde. */
  .stranka,
  .tok {
    width: 124mm;
    margin: 0 auto 8mm;
    padding: 12mm;
    box-sizing: content-box;
    background: var(--papir);
    box-shadow: 0 2mm 8mm rgb(0 0 0 / 0.15);
  }

  /* Jediná strana s pevnou výškou — je navržená, ne tekoucí. */
  .stranka {
    height: 186mm;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* ---------- Titulní strana ---------- */

  .letak-hlava {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 4mm;
  }

  .letak-logo {
    width: 52mm;
    height: auto;
  }

  /* Na jeden radek. `max-width` sem pribylo, kdyz se do hlavicky pridalo
     volebni cislo - a lamalo dovetek na dva radky, i kdyz se cely vejde.
     `nowrap` je pojistka pro pripad jineho pisma. */
  .letak-doplnek {
    margin: 2mm 0 0;
    font-size: 3.2mm;
    white-space: nowrap;
    line-height: 1.35;
    color: var(--inkoust-tlum);
  }

  .letak-claim {
    margin: 9mm 0 0;
    font-weight: 650;
    line-height: 0.98;
    letter-spacing: -0.04em;
    color: var(--sedozelena-text);
  }

  .letak-claim-zacatek,
  .letak-claim-konec {
    display: block;
  }

  .letak-claim-zacatek {
    font-size: 13mm;
  }

  .letak-claim-konec {
    margin-top: 1mm;
    font-size: 7mm;
    font-weight: 600;
    letter-spacing: -0.028em;
  }

  .letak-foto {
    width: 100%;
    height: auto;
    margin-top: 5mm;
  }

  .letak-uvod {
    margin: 4mm 0 0;
    font-size: 3.6mm;
    line-height: 1.5;
    color: var(--inkoust-tlum);
  }

  /* `margin-top: auto` přilepí patičku ke spodní hraně, ať je textu nad ní
     kolik chce — na papíře nejde dorovnávat mezerou od oka. */
  .letak-pata-predni {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4mm;
    margin-top: auto;
    padding-top: 4mm;
    border-top: 0.4mm solid var(--linka-vyrazna);
  }

  .letak-volby {
    margin: 0;
    font-size: 3.2mm;
    line-height: 1.45;
    color: var(--inkoust-tlum);
  }

  .letak-volby strong {
    display: block;
    font-size: 4.2mm;
    color: var(--inkoust);
  }

  .letak-cislo {
    display: flex;
    align-items: center;
    gap: 2.5mm;
    margin: 0;
    /* Aby se ve flexove hlavicce nesmrsklo, kdyz je dovetek dlouhy. */
    flex: none;
  }

  .letak-cislo-znak {
    display: grid;
    place-items: center;
    width: 13.8mm;
    height: 13.8mm;
    border-radius: 50%;
    background: var(--sedozelena);
    color: #fff;
    font-size: 8mm;
    font-weight: 700;
    line-height: 1;
  }

  .letak-cislo-popis {
    font-size: 3.1mm;
    line-height: 1.3;
    color: var(--inkoust-tlum);
  }

  /* QR potřebuje kolem sebe klidnou plochu, jinak ho čtečky hůř najdou.
     Tichou zónu nese samo SVG (`margin: 2` v `nastroje/qr.mjs`), tady je
     jen odstup od sousedů. */
  .letak-qr {
    margin: 0;
