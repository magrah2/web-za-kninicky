---
import { getCollection, render } from 'astro:content';
import Zaklad from '../layouts/Zaklad.astro';
import { BARVA_TEMATU } from '../lib/temata';
import IkonaTematu from '../components/IkonaTematu.astro';
import { odkaz } from '../lib/odkaz';
import type { Tema } from '../lib/temata';

const oblasti = (await getCollection('program')).sort((a, b) => a.data.poradi - b.data.poradi);

/**
 * Počet oblastí slovy, prvním pádem a s velkým písmenem — do věty
 * „Pět oblastí, ve kterých…".
 *
 * Číslice by ve větě byla suchá a natvrdo napsané slovo by se rozešlo
 * s obsahem, jakmile oblast přibude nebo ubude. Nad deset se vrátí číslice:
 * tolik programových oblastí web neunese a vypisovat číslovky donekonečna
 * by bylo víc práce než užitku.
 */
const CISLOVKY = ['Nula', 'Jedna', 'Dvě', 'Tři', 'Čtyři', 'Pět', 'Šest', 'Sedm', 'Osm', 'Devět', 'Deset'];
const pocetOblastiSlovy = CISLOVKY[oblasti.length] ?? String(oblasti.length);

const sObsahem = await Promise.all(
  oblasti.map(async (oblast) => ({ ...oblast, Obsah: (await render(oblast)).Content })),
);
---

<Zaklad
  titulek="Náš program"
  popis="Naše priority pro Kníničky. Program pro volby do zastupitelstva městské části Brno-Kníničky."
>
  <div class="pruh">
    <p class="nadtitulek">Náš program</p>
    <h1 class="nadpis">Naše priority pro Kníničky</h1>
    {/* Počet oblastí se nepíše natvrdo. Kdyby v textu stálo „Pět oblastí"
        a někdo šestou přidal, věta by lhala — a nikdo by si toho nevšiml,
        protože sestavení projde. Číslovka se proto skládá z délky kolekce. */}
    <p class="perex uvod">
      {pocetOblastiSlovy} oblastí, ve kterých máme jasnou představu, kam by se
      Kníničky měly posunout.
    </p>

    <ol class="oblasti">
      {
        sObsahem.map((oblast) => (
          <li
            class="oblast"
            id={`oblast-${oblast.data.poradi}`}
            style={`--barva: ${BARVA_TEMATU[oblast.data.tema as Tema]}`}
          >
            <div class="oblast-hlava">
              <span class="oblast-cislo" aria-hidden="true">
                {String(oblast.data.poradi).padStart(2, '0')}
              </span>
              <div>
                <h2 class="oblast-nadpis">
                  <IkonaTematu
                    tema={oblast.data.tema as Tema}
                    class="oblast-ikona"
                  />
                  <span>{oblast.data.nadpis ?? oblast.data.nazev}</span>
                </h2>
              </div>
            </div>
            {/* Shrnutí stojí mimo hlavičku, aby se dalo odsadit stejně jako
                odrážky pod ním — uvnitř hlavičky by ho držel sloupec vedle
                kolečka s číslem a na mobilu by viselo vpravo. */}
            <p class="oblast-shrnuti">{oblast.data.shrnuti}</p>
            <div class="oblast-obsah">
              <oblast.Obsah />
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Zaklad>

<style>
  /* Šířka textového sloupce celé stránky — o půldruhého centimetru větší než
     běžný text webu, na přání týmu: odrážky programu jsou dlouhá souvětí
     a v základní šířce se každá lámala o řádek víc. Drží ji úvodní věta,
     shrnutí oblastí i odrážky, aby měly stejně dlouhý řádek. Jinde na webu
     platí `--sirka-textu` dál, aby se běžný text četl po zhruba 70 znacích. */
  .pruh {
    --sirka-bloku: calc(var(--sirka-textu) + 1.5cm);
  }

  .nadpis {
    max-width: 20ch;
  }

  .uvod {
    margin-top: 1rem;
    max-width: var(--sirka-bloku);
  }

  .oblasti {
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0;
  }

  /* Odsazení textu pod nadpisem = šířka kolečka s číslem plus mezera vedle
     něj. Drží ho shrnutí i odrážky, aby obojí licovalo s nadpisem; kdyby si
     to každý počítal sám, rozejde se to při první změně kolečka. */
  .oblast {
    --odsazeni-textu: calc(2.75rem + clamp(0.9rem, 2vw, 1.5rem));
    /* Odsazení textu odrážky od jejího puntíku. V rem, ne v em: shrnutí je
       o stupeň menší než odrážky, takže by se v em obojí odsadilo jinak
       a lícování by se rozešlo právě tam, kde má platit. */
    --odsazeni-odrazky: 1.2rem;
    padding-block: clamp(1.75rem, 3.5vw, 2.75rem);
    border-top: 1px solid var(--linka);
    scroll-margin-top: 6rem;
  }

  .oblast:last-child {
    border-bottom: 1px solid var(--linka);
  }

  /* Kolečko s číslem a nadpis se srovnávají na střed. Nahoře (`start`) seděl
     nadpis o pár pixelů výš než střed kolečka, protože kolečko je vyšší než
     řádek nadpisu — a ta dvojice pak vypadala rozhozeně. */
  .oblast-hlava {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2vw, 1.5rem);
  }

  /* Číslo v barvě programové oblasti — stejný odstín pak ponese
     příslušný bod na mapě záměrů, takže se to spojí i vizuálně. */
  .oblast-cislo {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--barva) 14%, transparent);
    color: var(--barva);
    font-size: var(--text-maly);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  /* Zalícované s textem odrážek pod sebou, ne s jejich puntíky — proto
     k odsazení textu přibývá ještě odsazení uvnitř seznamu. */
  .oblast-shrnuti {
    max-width: var(--sirka-bloku);
    margin: 0.45rem 0 0 var(--odsazeni-textu);
    padding-left: var(--odsazeni-odrazky);
    font-size: var(--text-maly);
    color: var(--inkoust-tlum);
  }

  /* Ikona i text nadpisu se srovnávají na střed — stejně jako kolečko s číslem
     vedle nich. Dřív visela ikona nahoře (`start`) a dorovnávala se odsazením
     o 0,3 rem; to platilo pro jednu velikost písma a při každé změně nadpisu
     se muselo přeměřovat. */
  .oblast-nadpis {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* Barvu bere z kolečka s číslem, které stojí vedle — stejný odstín jako
     ta oblast na úvodní stránce a její body na mapě záměrů. */
  .oblast-nadpis :global(.oblast-ikona) {
    color: var(--barva);
  }

  .oblast-obsah {
    max-width: var(--sirka-bloku);
    margin-top: 1.1rem;
    margin-left: var(--odsazeni-textu);
  }

  .oblast-obsah :global(ul) {
    margin: 0;
    padding-left: var(--odsazeni-odrazky);
  }

  .oblast-obsah :global(li) {
    margin-bottom: 0.5em;
  }

  .oblast-obsah :global(li)::marker {
    color: var(--zelena);
  }

  @media (max-width: 560px) {
    /* Odrážky jsou dlouhé věty a v základní velikosti z nich byla na mobilu
       zeď textu. O stupeň menší písmo dá na řádek víc slov — stejný krok jako
       u odpovědí na /otazky/, aby se obě stránky na telefonu četly stejně.
       Nadpis oblasti i shrnutí zůstávají, ty mají nad odrážkami vyčnívat. */
    .oblast-obsah {
      margin-left: 0;
      font-size: var(--text-maly);
    }

    /* Na mobilu jdou obojí k levému okraji — shrnutí se tím zalícuje
       s odrážkami pod ním. */
    .oblast-shrnuti {
      margin-left: 0;
    }

    /* Ikona oblasti se na úzkém displeji na přání týmu neukazuje: vedle
       kolečka s číslem byly na řádku dvě značky a nadpis se kvůli nim lámal
       na dva řádky. Je jen ozdobná (`aria-hidden`), takže skrytím se nic
       neztrácí — na počítači, na úvodní stránce a na mapě zůstává. */
    .oblast-nadpis :global(.oblast-ikona) {
      display: none;
    }
  }
</style>
