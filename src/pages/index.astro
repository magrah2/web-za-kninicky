---
import { getCollection, render } from 'astro:content';
import Zaklad from '../layouts/Zaklad.astro';
import KartaKandidata from '../components/KartaKandidata.astro';
import { odkaz } from '../lib/odkaz';
import IkonaTematu from '../components/IkonaTematu.astro';
import { BARVA_TEMATU } from '../lib/temata';
import type { Tema } from '../lib/temata';
import { fotkaKandidata } from '../lib/portrety';
import { Image } from 'astro:assets';
import spolecnaFotka from '../assets/spolecna-fotka.jpg';
import {
  NAZEV,
  NAZEV_UPLNY,
  HESLO_ZACATEK,
  HESLO_KONEC,
  ZASTUPITELSTVO,
  POCET_ZASTUPITELU,
  POCET_SLOVY,
  DATUM_VOLEB,
  ZACATEK_VOLEB,
  KONEC_VOLEB,
} from '../lib/strana';
import { odpocet } from '../lib/odpocet';

/** Spočítá se při sestavení, aby stránka měla správný text i bez JavaScriptu.
    Skript na stránce si to pak přepočítá, aby číslo nezestárlo mezi nasazeními. */
const stavVoleb = odpocet(ZACATEK_VOLEB, KONEC_VOLEB);

const program = (await getCollection('program')).sort((a, b) => a.data.poradi - b.data.poradi);

const programSObsahem = await Promise.all(
  program.map(async (oblast) => ({ ...oblast, Obsah: (await render(oblast)).Content })),
);

const kandidati = (await getCollection('kandidati')).sort((a, b) => a.data.poradi - b.data.poradi);

// Na úvodní stránce je jen ochutnávka — přesně jedna řada mřížky. Zbytek
// je za odkazem „Všech 9". Kdyby jich tu bylo devět, druhá řada by zůstala
// ze tří čtvrtin prázdná a vypadalo by to jako chyba sazby, ne jako záměr.
const prvni = kandidati.slice(0, 6);
---

<Zaklad
  titulek={NAZEV}
  popis={`Nezávislí kandidáti do ${ZASTUPITELSTVO}. Volby ${DATUM_VOLEB}.`}
  bezOdsazeni
>
  {/* ---------- Hero ---------- */}
  <section class="hero">

    <div class="pruh hero-vnitrek">
      <div class="hero-text">
        <h1 class="hero-claim">
          <span class="hero-claim-zacatek">{HESLO_ZACATEK}</span>
          <span class="hero-claim-konec">{HESLO_KONEC}</span>
        </h1>

        {/* Text dodal tým — není to placeholder. „Kníničky" je tu natvrdo,
            protože `strana.ts` má jen tvary „v Kníničkách" a „z Kníniček";
            první pád by se z nich poskládat nedal. */}
        <div class="hero-perex">
          <p>
            Jsme sdružení nezávislých kandidátů, kterým leží na srdci, aby se Kníničky
            staly místem přívětivým pro všechny – bez ohledu na věk, zájmy nebo to, jak
            dlouho tu žijí. Naši kandidátku proto tvoří lidé různých generací a pohledů
            na svět.
          </p>
          <p>
            Jsme realisté a víme, že ne vždy lze vyhovět všemu a všem. Ale jen pokud
            budeme mít ucelenější představu o vašich potřebách a obavách, můžeme dělat
            lepší rozhodnutí. Pojďte s námi více komunikovat – my vám budeme naslouchat
            a vysvětlovat, proč a jak věci řešíme.
          </p>
        </div>

      </div>

      {/* Společná fotka kandidátky. Dřív tu stálo logo — to je pryč: od chvíle,
          kdy je z něj jen nápis, opakovalo totéž, co je o pár pixelů výš
          v hlavičce.

          Ořezává se jen po stranách, nikdy shora ani zdola: lidé stojí v řadě
          a vodorovný ořez by uřízl hlavy nebo nohy. */}
      <Image
        class="hero-foto"
        src={spolecnaFotka}
        alt={`Kandidáti sdružení ${NAZEV}`}
        widths={[640, 960, 1280]}
        sizes="(max-width: 899px) 92vw, 640px"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />

      {/* Tlačítka stojí VEDLE `.hero-text`, ne v něm, a je to schválně: fotka
          vpravo se výškou srovnává s textovým blokem a tlačítka se do té
          výšky počítat nemají. Kdyby zůstala uvnitř, fotka by se natáhla
          až pod ně a musela by se víc ořezat. Na mřížce sedí v druhém řádku
          prvního sloupce, tedy přesně pod textem. */}
      <div class="hero-tlacitka">
        <a class="tlacitko tlacitko-hlavni" href={odkaz('/program/')}>Náš program</a>
        <a class="tlacitko tlacitko-vedlejsi" href={odkaz('/jak-volit/')}>Jak volit →</a>
      </div>
    </div>

    <p class="pruh hero-volby">
      <span class="hero-volby-datum">Volby do {ZASTUPITELSTVO}</span>
      <span class="hero-volby-oddel" aria-hidden="true">·</span>
      <span>{DATUM_VOLEB}</span>
      <span class="hero-volby-oddel" aria-hidden="true">·</span>
      <span data-odpocet-od={ZACATEK_VOLEB} data-odpocet-do={KONEC_VOLEB}>
        {stavVoleb.text}
      </span>
    </p>

    {/* Úplný název tak, jak je na kandidátní listině. Ve zbytku webu se používá
        krátké „Za Kníničky" — tohle je čtvrté místo, kde má stát celý název
        (vedle zkušebního lístku, oznámení o transparentnosti a správce údajů).

        Skládá se z `NAZEV_UPLNY`, ne napsaný ručně: jména podporujících stran
        jsou právní údaj a nesmí se rozejít s lístkem.

        Znaky ODS a KDU-ČSL tu nejsou. Jsou to ochranné známky cizích stran,
        takže se nesmí nakreslit „podobné" a musí přijít od nich jako soubory
        do `src/assets/` — stahovat je za běhu ze stránek stran nelze, web
        nesmí posílat požadavky na cizí servery. */}
    <p class="pruh hero-podpora">{NAZEV_UPLNY}</p>
  </section>

  {/* ---------- Kdo jsme ---------- */}
  <section class="sekce">
    <div class="pruh dvojice">
      <div>
        <p class="nadtitulek">Kdo jsme</p>
        <h2>{POCET_SLOVY.charAt(0).toUpperCase() + POCET_SLOVY.slice(1)} lidí, kteří tady žijí</h2>
      </div>
      {/* Text dodal tým — není to placeholder. */}
      <div class="dvojice-text">
        <p>
          Za kandidátkou <span class="nazev-strany">{NAZEV}</span> stojí pestrá skupina lidí,
          které spojuje jedno – chuť
          starat se o místo, kde žijeme. Najdete mezi námi lidi nejrůznějších profesí
          i generací: od studentky přes rodiče malých i velkých dětí až po prarodiče
          a seniory. Každý z nás přináší jiný pohled a jinou zkušenost a právě tato
          rozmanitost nám pomáhá vidět potřeby Kníniček z více úhlů.
        </p>
        <p>
          <a href={odkaz('/lide/')}>Poznejte všech {POCET_ZASTUPITELU} →</a>
        </p>
      </div>
    </div>
  </section>

  {/* ---------- Program ---------- */}
  <section class="sekce program" id="program">
    <div class="pruh">
      <p class="nadtitulek">Náš program</p>
      <h2 class="program-nadpis">Co chceme v Kníničkách změnit</h2>

      <div class="program-mrizka">
        {
          programSObsahem.map((oblast) => (
            <a
              class="dlazdice"
              href={`#oblast-${oblast.id}`}
              data-dlazdice={oblast.id}
              style={`--barva-oblasti: ${BARVA_TEMATU[oblast.data.tema as Tema]}`}
            >
              <span class="dlazdice-nadpis">
                <IkonaTematu
                  tema={oblast.data.tema as Tema}
                  class="dlazdice-ikona"
                />
                <span class="dlazdice-nazev">{oblast.data.nazev}</span>
                <span class="dlazdice-znak" aria-hidden="true">→</span>
              </span>
              <span class="dlazdice-shrnuti">{oblast.data.shrnuti}</span>
            </a>
          ))
        }
      </div>

      {/* ---------- Sdílený panel ----------
          Jen jeden na stránce, přes celou šířku, pod mřížkou. Otevírá ho
          CSS `:target` (funguje i bez JavaScriptu), takže se dlaždice
          nikdy samy nerozbalují a mřížka se nehýbe — ať je otevřené
          cokoliv, ostatní dlaždice zůstávají přesně tam, kde byly. */}
      <div class="program-panely" data-program-panely>
        {
          programSObsahem.map((oblast) => (
            <div class="program-panel" id={`oblast-${oblast.id}`} data-panel={oblast.id}>
              <a class="program-panel-zavrit" href="#program" data-zavrit>
                <span aria-hidden="true">×</span>
                <span class="jen-pro-ctecky">Zavřít</span>
              </a>
              <p class="program-panel-nadtitulek">{oblast.data.nazev}</p>
              <h3 class="program-panel-nadpis">{oblast.data.nadpis ?? oblast.data.nazev}</h3>
              <div class="dlazdice-obsah">
                <oblast.Obsah />
              </div>
            </div>
          ))
        }
      </div>

      <p class="program-odkaz">
        <a class="tlacitko tlacitko-vedlejsi" href={odkaz('/program/')}>Celý program</a>
      </p>
    </div>
  </section>

  {/* ---------- Mapa záměrů ---------- */}
  <section class="sekce pas-noc zamery">
    <div class="pruh zamery-vnitrek">
      <div>
        <p class="nadtitulek">Mapa záměrů</p>
        {/* Totéž, co je nad mapou na `/mapa/` (MapaZameru.astro). Opsané je to
            schválně: úvodní stránka mapu nevkládá, jen na ni odkazuje, takže
            nemá odkud text vzít. Když se mění, mění se na obou místech.

            Dřív tu stálo „Placeholder. Mapa Kníniček je připravená, body na ni
            teprve doplníme" — to přestalo platit ve chvíli, kdy na mapě body
            přibyly. */}
        <h2>Náš program nejsou jen sliby na&nbsp;papíře.</h2>
        <p class="perex">
          Jsou to místa, kolem kterých každý den procházíte – a u každého víme přesně,
          co a jak chceme zlepšit.
        </p>
        <p class="zamery-tlacitko">
          <a class="tlacitko tlacitko-hlavni" href={odkaz('/mapa/')}>Otevřít mapu</a>
        </p>
      </div>
    </div>
  </section>

  {/* ---------- Lidé ---------- */}
  <section class="sekce lide">
    <div class="pruh">
      <div class="lide-hlava">
        <div>
          <p class="nadtitulek">Komu dáte hlas</p>
          <h2>Naši kandidáti</h2>
        </div>
        <a class="tlacitko tlacitko-vedlejsi" href={odkaz('/lide/')}>Všech {POCET_ZASTUPITELU} →</a>
      </div>

      <div class="lide-mrizka">
        {
          prvni.map((clovek) => (
            <KartaKandidata
              poradi={clovek.data.poradi}
              jmeno={clovek.data.jmeno}
              vek={clovek.data.vek}
              povolani={clovek.data.povolani}
              foto={fotkaKandidata(clovek.id)}
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- Jak volit ---------- */}
  <section class="sekce pas-noc jak-volit">
    <div class="pruh jak-volit-vnitrek">
      <div>
        <p class="nadtitulek">Jak volit</p>
        <h2>Do zastupitelstva máte {POCET_ZASTUPITELU} křížků. Věděli jste to?</h2>
        <p class="perex">
          Komunální volby fungují jinak než všechny ostatní a většina lidí to neví.
          Můžete dát hlas celé kandidátce, vybírat jednotlivce napříč stranami, nebo obojí
          zkombinovat. Ukážeme vám to na hlasovacím lístku, který si můžete vyzkoušet.
        </p>
        <p class="jak-volit-tlacitko">
          <a class="tlacitko tlacitko-hlavni" href={odkaz('/jak-volit/')}>Vyzkoušet lístek</a>
        </p>
      </div>
    </div>
  </section>
</Zaklad>

<style>
  /* ---------- Hero ---------- */

  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2rem, 4vw, 3.25rem);
  }

  /* `row-gap` je nula schválně. Mřížka má tři prvky (text, fotka, tlačítka)
     a svislé rozestupy si mezi nimi drží samy prvky svým `margin-top` —
     kdyby k tomu přibyla ještě mezera mřížky, sečetly by se a pod perexem
     by vznikla díra. */
  .hero-vnitrek {
    position: relative;
    z-index: 1;
    display: grid;
    column-gap: clamp(2rem, 5vw, 3rem);
    row-gap: 0;
    align-items: start;
  }

  /* Na širokém displeji stojí fotka vedle textu. Na úzkém sjede pod něj —
     nad claimem by odsunula dolů větu, kvůli které hero existuje. Pořadí
     zařídí samo DOM, takže tu nejsou žádná pravidla `order`. */
  /* Fotka dostává víc místa než text. Dál už se roztáhnout nemůže: perex má
     doraz 42 ch (~410 px) a claim „Povídejte," je v hero velikosti přes
     450 px široký, takže při užším levém sloupci by se začal lámat.

     Fotka sedí v prvním řádku vedle textu, tlačítka v druhém pod textem.
     Řádek je proto vysoký jako claim s perexem a `stretch` na tu výšku
     natáhne i fotku — tlačítka se do ní nepočítají. */
  @media (min-width: 900px) {
    .hero-vnitrek {
      grid-template-columns: 1fr 1.3fr;
      align-items: stretch;
    }

    .hero-foto {
      grid-row: 1;
      grid-column: 2;
      height: 100%;
      /* Ořezává se po stranách, ne shora a zdola: lidé stojí v řadě a nahoře
         mají nad hlavami stromy, dole dlažbu — vodorovný ořez by uřízl hlavy.
         Skupina zabírá zhruba prostřední dvě třetiny snímku (16–76 % šířky),
         takže symetrický ořez ji nezasáhne. */
      object-fit: cover;
    }

    .hero-tlacitka {
      grid-column: 1;
    }
  }

  /* Na úzkém displeji je jeden sloupec a fotka patří až za tlačítka —
     mezi perex a tlačítka by se vklínila a odtrhla výzvu od textu,
     kvůli kterému tam je. */
  @media (max-width: 899px) {
    .hero-foto {
      order: 1;
      margin-top: clamp(1.5rem, 5vw, 2.25rem);
    }
  }

  /* Fotka si nese vlastní poměr stran, žádný `aspect-ratio` tu není —
     `<Image>` zapisuje `width` a `height` z původního souboru, takže si
     místo drží od začátku a stránka při načtení neposkočí.

     Rohy jsou ostré. Zaoblení je na webu vyhrazené kartám a dlaždicím —
     tedy plochám, které něco ohraničují; fotka je obsah, ne karta. */
  .hero-foto {
    width: 100%;
    height: auto;
    box-shadow: var(--stin);
  }

  /* Claim je dvouhlasý: „Povídejte," nahoře velké, „my nasloucháme." pod tím
     menší. Velikost druhého řádku je v `em`, tedy podílem prvního — takhle
     se poměr drží i na mobilu, kde `--text-hero` spadne skoro na polovinu.
     Kdyby měl každý řádek vlastní `clamp()`, poměr by se s šířkou okna
     pohyboval a někde by se řádky srovnaly do stejné velikosti. */
  .hero-claim {
    max-width: 14ch;
    margin: 0;
    font-size: var(--text-hero);
    font-weight: 650;
    line-height: 0.95;
    letter-spacing: -0.042em;
    color: var(--sedozelena-text);
  }

  .hero-claim-zacatek,
  .hero-claim-konec {
    display: block;
  }

  .hero-claim-konec {
    font-size: 0.52em;
    font-weight: 600;
    /* Menší stupeň unese míň stažené prostrkání — v `-0.042em` vypadala
       písmena slepená, protože záporné prostrkání se počítá z velikosti
       písma a na menším řádku ubere poměrně víc. */
    letter-spacing: -0.028em;
    line-height: 1.1;
    margin-top: 0.18em;
  }

  /* O kousek menší než `--text-velky`, ne o celý stupeň níž. Odstavce jsou
     tu dva a v plné velikosti perexu přebíjely claim nad sebou; posunout je
     rovnou na `--text-zakladni` by z nich zas udělalo běžný text stránky,
     který v heru vypadá jako popiska. Proto podíl, ne jiný token — škála
     se tím nerozšiřuje o devátý stupeň. */
  /* Doraz je v `ch`, ne v procentech: řádek má mít pod osmdesát znaků,
     jinak oko na konci řádku ztrácí, kde začíná další. Sloupec vedle fotky
     je na tuhle míru i tak užší, takže se doraz projeví hlavně na širokém
     displeji bez fotky. */
  .hero-perex {
    max-width: 42ch;
    margin: clamp(1.4rem, 3vw, 2rem) 0 0;
    font-size: calc(var(--text-velky) * 0.86);
    line-height: 1.55;
    color: var(--inkoust-tlum);
  }

  /* Odstavce uvnitř si nesmějí vzít odsazení od prohlížeče: nahoře by přidalo
     mezeru k té, kterou už má obal, a mezi odstavci by při téhle velikosti
     písma vznikla díra. Mezera je proto v `em`, tedy úměrná velikosti textu. */
  .hero-perex p {
    margin: 0;
  }

  .hero-perex p + p {
    margin-top: 0.7em;
  }

  .hero-tlacitka {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: clamp(1.6rem, 3vw, 2.2rem);
  }

  .hero-volby {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
    /* Jen margin-top, ne zkrácený zápis: `margin: X 0 0` by přebilo
       `margin-inline: auto` ze třídy `.pruh` a pruh by se přestal zarovnávat. */
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 1.1rem;
    border-top: 1px solid var(--linka);
    font-size: var(--text-maly);
    color: var(--inkoust-tlum);
  }

  .hero-volby-datum {
    font-weight: 600;
    color: var(--inkoust);
  }

  .hero-volby-oddel {
    color: var(--linka-vyrazna);
  }

  /* Úplný název s podporou stran. Tichý řádek pod formálními údaji o volbách —
     patří k nim, ne k tvrzení nahoře, a nemá ho přebít. Proto `--text-maly`
     a žádná linka navíc: tu už má `.hero-volby` nad sebou.

     Jen `margin-top`, ne zkrácený zápis — `margin: X 0 0` by přebilo
     `margin-inline: auto` ze třídy `.pruh` a řádek by se přestal zarovnávat
     se zbytkem stránky. Totéž platí o `.hero-volby` nad ním. */
  /* Bez `max-width`: prvek nese i třídu `.pruh`, která mu dává šířku pruhu
     a `margin-inline: auto`. Doraz by ho zúžil a to `auto` by ho pak
     vycentrovalo doprostřed stránky, pryč od levé hrany textu nad ním.
     Samotný název je krátký, takže se stejně nikde neroztáhne. */
  .hero-podpora {
    margin-top: 0.9rem;
    font-size: var(--text-maly);
    font-weight: 600;
    color: var(--inkoust);
  }

  /* Na mobilu se řádek stejně zalomí a oddělovač by zůstal viset
     na konci řádku jako překlep. Radši ho schováme a dáme řádkům odstup. */
  @media (max-width: 620px) {
    .hero-volby {
      display: grid;
      gap: 0.15rem;
      justify-items: start;
    }
    .hero-volby-oddel {
      display: none;
    }
  }

  /* ---------- Dvousloupcová sekce ---------- */

  .dvojice {
    display: grid;
    gap: 1.5rem 3rem;
  }

  @media (min-width: 820px) {
    .dvojice {
      grid-template-columns: 1fr 1.15fr;
      gap: 3.5rem;
    }
  }

  .dvojice-text {
    max-width: var(--sirka-textu);
  }

  /* ---------- Program ---------- */

  .program-nadpis {
    max-width: 20ch;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .program-mrizka {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 620px) {
    .program-mrizka {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .program-mrizka {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Dlaždice sama nic nerozbaluje — jen odkazuje na svůj panel níž.
     Díky tomu se nikdy nemění výška mřížky, ať je otevřené cokoliv. */
  .dlazdice {
    display: block;
    background: var(--plocha);
    border: 1px solid var(--linka);
    border-radius: var(--radius);
    box-shadow: var(--stin);
    padding: 1.15rem 1.25rem;
    color: inherit;
    text-decoration: none;
    transition: box-shadow var(--prechod), border-color var(--prechod);
  }

  .dlazdice:hover {
    border-color: var(--linka-vyrazna);
    box-shadow: var(--stin-zvednuty);
  }

  .dlazdice.je-aktivni {
    border-color: var(--sedozelena);
  }

  /* Ikona a název drží vedle sebe, šipku odstrčí doprava `margin` u názvu.
     `space-between` tu být nemůže — rozhodilo by to ikonu od názvu. */
  .dlazdice-nadpis {
    display: flex;
    align-items: start;
    gap: 0.55rem;
  }

  /* Ikona nese barvu své oblasti — stejný odstín pak má ta oblast
     i na `/program/` a její body na mapě záměrů. */
  .dlazdice :global(.dlazdice-ikona) {
    /* Odsazení srovná ikonu s prvním řádkem názvu. U dvouřádkového názvu
       by se jinak zarovnala na střed obou řádků a vypadala nakřivo. */
    margin-top: 0.15rem;
    color: var(--barva-oblasti);
  }

  .dlazdice-nazev {
    margin-right: auto;
    font-size: var(--text-nadpis-3);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .dlazdice-znak {
    flex: none;
    color: var(--sedozelena);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--prechod), transform var(--prechod);
  }

  .dlazdice:hover .dlazdice-znak,
  .dlazdice.je-aktivni .dlazdice-znak {
    opacity: 1;
    transform: translateX(0);
  }

  .dlazdice-shrnuti {
    display: block;
    margin-top: 0.45rem;
    font-size: var(--text-maly);
    line-height: 1.5;
    color: var(--inkoust-tlum);
  }

  /* ---------- Sdílený panel ----------
     Beze všeho otevřeného nezabírá vůbec žádné místo — každý panel má
     `display: none` a zviditelní ho, spolu s odsazením, teprve `:target`. */
  .program-panel {
    display: none;
  }

  .program-panel:target {
    position: relative;
    display: block;
    margin-top: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--plocha);
    border: 1px solid var(--linka);
    border-radius: var(--radius);
    box-shadow: var(--stin-zvednuty);
    scroll-margin-top: 6rem;
    animation: panel-nahoru 0.22s ease-out;
  }

  @keyframes panel-nahoru {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .program-panel-zavrit {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 999px;
    background: var(--papir);
    color: var(--inkoust);
    font-size: 1.3rem;
    line-height: 1;
    text-decoration: none;
    transition: background var(--prechod);
  }

  .program-panel-zavrit:hover {
    background: var(--sedozelena-jemna);
    color: var(--sedozelena-text);
  }

  .program-panel-nadtitulek {
    margin: 0;
    max-width: calc(100% - 3rem);
  }

  .program-panel-nadpis {
    margin: 0.3rem 0 0;
    max-width: 40ch;
  }

  .program-panel .dlazdice-obsah {
    margin-top: 1.25rem;
    max-width: var(--sirka-textu);
    font-size: var(--text-zakladni);
  }

  .dlazdice-obsah :global(ul) {
    margin: 0;
    padding-left: 1.1em;
  }

  .dlazdice-obsah :global(li) {
    margin-bottom: 0.5em;
  }

  .dlazdice-obsah :global(li)::marker {
    color: var(--zelena);
  }

  .program-odkaz {
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
  }

  /* ---------- Lidé ---------- */

  .lide-hlava {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .lide-mrizka {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem) clamp(1rem, 2.5vw, 1.75rem);
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 620px) {
    .lide-mrizka {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 940px) {
    .lide-mrizka {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  /* ---------- Mapa záměrů ---------- */

  .zamery h2 {
    max-width: 22ch;
    margin-bottom: 1.1rem;
  }

  .zamery-tlacitko {
    margin: 1.75rem 0 0;
  }

  /* ---------- Jak volit ---------- */

  .jak-volit h2 {
    max-width: 20ch;
    margin-bottom: 1.1rem;
  }

  .jak-volit-tlacitko {
    margin: 1.75rem 0 0;
  }
</style>

<script>
  // Odpočet se přepočítá v prohlížeči. Kdyby se počítal jen při sestavení,
  // po týdnu bez nasazení by na webu svítilo staré číslo.
  //
  // Text skládá `odpocet()` ze `src/lib/odpocet.ts` — tentýž kód, jaký běží
  // při sestavení. Opsaný na dvou místech by se rozešel.
  import { odpocet } from '../lib/odpocet';

  const prvek = document.querySelector<HTMLElement>('[data-odpocet-od]');
  const od = prvek?.dataset.odpocetOd;
  const doKdy = prvek?.dataset.odpocetDo;
  if (prvek && od && doKdy) {
    prvek.textContent = odpocet(od, doKdy).text;
  }
</script>

<script>
  // Zvýraznění dlaždice, jejíž panel je zrovna otevřený. Čistě kosmetické —
  // panel se otevírá i zavírá přes CSS `:target`, tohle jen dokresluje,
  // odkud otevřený obsah pochází.
  const dlazdice = [...document.querySelectorAll<HTMLAnchorElement>('.dlazdice')];

  function oznacAktivni() {
    const aktualni = location.hash.match(/^#oblast-(.+)$/)?.[1];
    for (const d of dlazdice) {
      d.classList.toggle('je-aktivni', !!aktualni && d.dataset.dlazdice === aktualni);
    }
  }

  window.addEventListener('hashchange', oznacAktivni);
  oznacAktivni();
</script>
