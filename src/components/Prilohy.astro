---
/**
 * Dokumenty ke stažení pod otázkou nebo aktualitou.
 *
 * Samostatná komponenta, protože ji používají dvě stránky (`/otazky/`
 * a `/aktuality/`) a přílohy na nich mají vypadat stejně. Dostává už
 * připravené přílohy z `pripravPrilohu()` — velikost a typ se dopočítávají
 * tam, protože uvnitř šablony se k disku nedostaneme.
 */
import { odkaz } from '../lib/odkaz';
import type { Priloha } from '../lib/prilohy';

interface Props {
  prilohy: Priloha[];
}

const { prilohy } = Astro.props;
---

{
  prilohy.length > 0 && (
    <div class="prilohy">
      {/* Nadpis se na přání týmu netiskne na stránku — štítek PDF
          u každého odkazu mluví sám za sebe. Pro čtečky obrazovky
          ale zůstává: bez něj by byl seznam odkazů bez uvození. */}
      <h3 class="prilohy-nadpis jen-pro-ctecky">Ke stažení</h3>
      <ul>
        {prilohy.map((p) => (
          <li>
            <a
              class="priloha"
              href={p.externi ? p.cesta : odkaz(p.cesta)}
              download={p.externi ? undefined : true}
              target={p.externi ? '_blank' : undefined}
              rel={p.externi ? 'noopener' : undefined}
            >
              <span class="priloha-typ" aria-hidden="true">
                {p.typ}
              </span>
              <span class="priloha-text">
                <span class="priloha-nazev">{p.nazev}</span>
                {p.popis && <span class="priloha-popis">{p.popis}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .prilohy {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--linka);
  }

  .prilohy-nadpis {
    margin: 0 0 0.6rem;
    font-size: var(--text-drobny);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--inkoust-tlum);
  }

  .prilohy ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .priloha {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--linka);
    border-radius: var(--radius);
    color: var(--inkoust);
    text-decoration: none;
  }

  .priloha:hover {
    border-color: var(--sedozelena);
    background: var(--sedozelena-jemna);
  }

  /* Přípona místo ikony: řekne rovnou, co se stáhne, a nepotřebuje obrázek. */
  .priloha-typ {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius);
    background: var(--sedozelena);
    color: #fff;
    font-size: var(--text-drobny);
    font-weight: 700;
  }

  .priloha-text {
    display: grid;
    gap: 0.15rem;
  }

  /* Kurzíva a běžný řez místo tučného, na přání týmu: název dokumentu se
     tak odliší od nadpisů kolem, aniž by přetahoval pozornost. */
  .priloha-nazev {
    font-style: italic;
  }

  .priloha-popis {
    font-size: var(--text-drobny);
    color: var(--inkoust-tlum);
  }

  /* Na úzkém displeji se názvy dokumentů zmenšují spolu s textem nad nimi:
     dlouhé názvy se na mobilu lámaly na tři řádky a v původní velikosti by
     byly nápadnější než text, ke kterému patří. Štítek PDF zůstává — je už
     o dva stupně menší. */
  @media (max-width: 560px) {
    .priloha {
      font-size: var(--text-maly);
    }
  }
</style>
