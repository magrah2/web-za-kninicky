---
/**
 * Karta kandidáta v mřížce.
 *
 * Odkazuje na kotvu medailonku na stránce /lide/. Díky tomu funguje
 * i bez JavaScriptu: adresa s kotvou otevře medailonek přes CSS `:target`.
 * Skript na stránce /lide/ pak klik převezme a otevře překryv bez odskočení.
 */

import Portret from './Portret.astro';
import { odkaz, jmenoBezTitulu } from '../lib/odkaz';

interface Props {
  poradi: number;
  jmeno: string;
  /** Rodné příjmení bez slova „roz." — vypíše se za jménem, netučně. */
  rozena?: string | null;
  vek?: number;
  povolani: string;
  foto?: ImageMetadata;
  /** Zvolen do zastupitelstva — na fotce se ukáže štítek. */
  zvolen?: boolean;
  /** Funkce ve výboru nebo komisi — bílý štítek na fotce. */
  funkce?: string | null;
}

const { poradi, jmeno, rozena, vek, povolani, foto, zvolen = false, funkce } = Astro.props;

const cil = `${odkaz('/lide/')}#medailonek-${poradi}`;
---

<article class="karta-kandidata" data-poradi={poradi}>
  <a class="karta-odkaz" href={cil} data-medailonek={poradi}>
    {/* Číslo musí být uvnitř obalu portrétu, ne v celém odkazu —
        jinak se usadí až pod textem a přeleze přes jméno. */}
    <div class="karta-portret">
      <Portret foto={foto} jmeno={jmeno} velikost="karta" />
      <span class="karta-cislo" aria-hidden="true">{poradi}</span>
      {(zvolen || funkce) && (
        <span class="stitky-na-fotce">
          {zvolen && <span class="stitek-zvolen">V zastupitelstvu</span>}
          {funkce && <span class="stitek-funkce">{funkce}</span>}
        </span>
      )}
    </div>

    <span class="karta-text">
      <span class="karta-jmeno">
        {jmenoBezTitulu(jmeno)}
        {rozena && <span class="karta-rozena">, roz. {rozena}</span>}
      </span>
      <span class="karta-povolani">
        {vek ? `${vek} let · ` : ''}{povolani}
      </span>
    </span>

    <span class="jen-pro-ctecky">{jmeno} — otevřít medailonek</span>
  </a>
</article>

<style>
  .karta-kandidata {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .karta-odkaz {
    display: block;
    color: inherit;
    text-decoration: none;
    transition: transform var(--prechod);
  }

  .karta-odkaz:hover {
    transform: translateY(-3px);
  }

  .karta-portret {
    position: relative;
    display: block;
  }

  /* Číslo leží v levém horním rohu přímo na fotce. Dřív sedělo ve výřezu,
     který vznikl seříznutím levého dolního rohu portrétu — ten je pryč.
     Nahoře navíc nepřekrývá obličej, protože portréty jsou seříznuté na
     hlavu a ramena a v rozích je pozadí. */
  .karta-cislo {
    position: absolute;
    left: 0.6rem;
    top: 0.6rem;
    display: grid;
    place-items: center;
    min-width: 2.3rem;
    height: 2.3rem;
    padding-inline: 0.42rem;
    border-radius: 999px;
    background: var(--sedozelena);
    color: #fff;
    font-size: var(--text-zakladni);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  /* Štítky na fotce: dole vlevo, naproti číslu nahoře — v rozích
     nepřekrývají obličej. Nahoře zelený „V zastupitelstvu" (text bez rodu,
     aby se nemusel u každého řešit zvlášť), pod ním poloprůhledný s funkcí ve
     výboru. Funkce je doplněk, proto je tlumená a tenčím písmem: zelený štítek má zůstat
     to první, čeho si člověk všimne. Stejné štítky jsou v medailonku
     na /lide/ — při změně upravit obojí. */
  .stitky-na-fotce {
    position: absolute;
    left: 0.6rem;
    right: 0.6rem;
    bottom: 0.6rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
  }

  .stitek-zvolen,
  .stitek-funkce {
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-maly);
    font-size: var(--text-drobny);
    line-height: 1.3;
  }

  .stitek-zvolen {
    background: var(--sedozelena);
    color: #fff;
    font-weight: 600;
  }

  /* Podklad bílý průhledný na 40 % (tedy 60 % bílé), na přání týmu: plná bílá na tmavé
     fotce svítila víc než zelený štítek nad ním. Písmo o stupeň menší
     než u zeleného štítku. */
  .stitek-funkce {
    padding-block: 0.2rem;
    background: color-mix(in srgb, var(--plocha) 60%, transparent);
    color: var(--inkoust);
    font-size: var(--text-mini);
    font-weight: 500;
  }

  .karta-text {
    display: block;
    margin-top: 0.7rem;
  }

  .karta-jmeno {
    display: block;
    font-size: var(--text-zakladni);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  /* Rodné příjmení patří ke jménu, ale netučně: tučný řez tady odlišuje
     jméno od věku a povolání pod ním, a kdyby se do něj počítalo i „roz.",
     přestalo by to rozlišení dělat. */
  .karta-rozena {
    font-weight: 400;
  }

  .karta-odkaz:hover .karta-jmeno {
    color: var(--sedozelena-text);
  }

  .karta-povolani {
    display: block;
    margin-top: 0.15rem;
    font-size: var(--text-maly);
    line-height: 1.4;
    color: var(--inkoust-tlum);
  }
</style>
