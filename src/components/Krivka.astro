---
/**
 * Zelená stopa ze značky — jediný grafický motiv webu.
 *
 * Cesta je vytažená z břehu ve značce (nastroje/logo.mjs), takže se motiv
 * na webu a logo v hlavičce shodují. Vrací se ve třech podobách, aby web
 * držel pohromadě jedním tvarem místo náhodných ozdob:
 *
 *   varianta="podklad"    velká světlá stopa v pozadí, přetéká přes okraj
 *   varianta="oddelovac"  tenká křivka místo vodorovné čáry mezi sekcemi
 *   varianta="znacka"     malá plná stopa (odrážky, ikony)
 */

interface Props {
  varianta?: 'podklad' | 'oddelovac' | 'znacka';
  class?: string;
}

const { varianta = 'znacka', class: trida } = Astro.props;

/** Zelený břeh ze značky. Souřadnice patří k viewBoxu 0 0 240 240. */
const STOPA =
  'M4 158C30 108 54 100 82 124C104 143 118 143 140 118C168 86 200 88 240 122V158Z';
---

{
  varianta === 'oddelovac' ? (
    <svg
      class:list={['krivka-oddelovac', trida]}
      viewBox="0 0 1200 20"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      {/* Není to čára, ale výplň od křivky dolů — křivka je tím sama hranou
          pozadí sekce pod ní. Jako tah to nefungovalo: pod ní běžela rovná
          hrana pozadí, dvě téměř rovnoběžné čáry se rozbíhaly a vypadalo to
          rozbitě. Souměrná podle středu, řídicí body vpravo jsou zrcadlem
          těch vlevo (300 a 400 ↔ 800 a 900). */}
      <path
        d="M0,20 L0,14 C300,14 400,4 600,4 C800,4 900,14 1200,14 L1200,20 Z"
        fill="currentColor"
      />
    </svg>
  ) : (
    <svg
      class:list={[varianta === 'podklad' ? 'krivka-podklad' : 'krivka-znacka', trida]}
      viewBox="0 0 240 240"
      aria-hidden="true"
      focusable="false"
    >
      <path d={STOPA} fill="currentColor" />
    </svg>
  )
}

<style>
  .krivka-znacka {
    width: 1em;
    height: auto;
    color: var(--zelena);
    flex: none;
  }

  /* Výplň se musí dotknout obou okrajů okna, takže se tady nic nemaskuje
     ani nezaobluje — jinak by mezi křivkou a sekcí pod ní prosvítala mezera.
     Barvu si nastaví ten, kdo oddělovač použije: má to být pozadí sekce,
     která pod ním začíná. */
  .krivka-oddelovac {
    display: block;
    width: 100%;
    height: 20px;
    color: var(--plocha);
  }

  /* Podklad: velká měkká stopa, která se nesmí prát s textem.
     Má se dát vytušit, ne přečíst — proto tak nízká sytost. */
  .krivka-podklad {
    position: absolute;
    height: auto;
    color: var(--zelena);
    opacity: 0.11;
    pointer-events: none;
    user-select: none;
  }
</style>
